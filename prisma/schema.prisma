generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MaterialCategory {
  color
  developer
  bleach
  shampoo
  conditioner
  treatment
  styling
  tools
  disposables
  other
}

enum UnitOfMeasure {
  ml
  g
  piece
}

model Customer {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  comment    String?
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  visits     Visit[]

  @@index([userId, isArchived, name])
  @@map("customers")
}

model Material {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  name          String
  unitOfMeasure UnitOfMeasure    @map("unit_of_measure")
  category      MaterialCategory
  isArchived    Boolean          @default(false) @map("is_archived")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  purchases     Purchase[]
  lineItems     VisitLineItem[]

  @@unique([userId, name, category, unitOfMeasure])
  @@index([userId, isArchived, category, name])
  @@map("materials")
}

model Service {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  defaultPrice Decimal? @map("default_price") @db.Decimal(10, 2)
  displayOrder Int      @map("display_order")
  isArchived   Boolean  @default(false) @map("is_archived")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  visits       Visit[]

  @@unique([userId, name])
  @@unique([userId, displayOrder])
  @@index([userId, isArchived, displayOrder])
  @@map("services")
}

model Purchase {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  materialId    String   @map("material_id")
  totalQuantity Decimal  @map("total_quantity") @db.Decimal(10, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(10, 2)
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([userId, date, createdAt])
  @@index([userId, materialId, date])
  @@map("purchases")
}

model Visit {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  customerId   String   @map("customer_id")
  serviceId    String   @map("service_id")
  date         DateTime @db.Date
  priceCharged Decimal  @map("price_charged") @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer  Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  lineItems VisitLineItem[]

  @@index([userId, date, createdAt])
  @@index([userId, customerId, date])
  @@index([userId, serviceId, date])
  @@map("visits")
}

model VisitLineItem {
  id         String   @id @default(cuid())
  visitId    String   @map("visit_id")
  materialId String   @map("material_id")
  amount     Decimal  @db.Decimal(10, 2)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 6)
  totalCost  Decimal  @map("total_cost") @db.Decimal(12, 4)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@index([materialId])
  @@map("visit_line_items")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MaterialCategory {
  color
  developer
  bleach
  shampoo
  conditioner
  treatment
  styling
  tools
  disposables
  other
}

enum UnitOfMeasure {
  ml
  g
  piece
}

model Customer {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  comment    String?
  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, isArchived, name])
  @@map("customers")
}

model Material {
  id            String           @id @default(cuid())
  userId        String           @map("user_id")
  name          String
  unitOfMeasure UnitOfMeasure    @map("unit_of_measure")
  category      MaterialCategory
  isArchived    Boolean          @default(false) @map("is_archived")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@unique([userId, name, category, unitOfMeasure])
  @@index([userId, isArchived, category, name])
  @@map("materials")
}

model Service {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  defaultPrice Decimal? @map("default_price") @db.Decimal(10, 2)
  displayOrder Int      @map("display_order")
  isArchived   Boolean  @default(false) @map("is_archived")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@unique([userId, displayOrder])
  @@index([userId, isArchived, displayOrder])
  @@map("services")
}
